# 复制为 .env 后填写你的配置
API_KEY=
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-pro
# 可选：桌面端模型下拉列表，逗号分隔；/models 拉取失败时回退到这里
MODEL_OPTIONS=deepseek-v4-flash,deepseek-v4-pro
# 可选：默认思考程度，支持 off / low / medium / high / max
# DeepSeek 模型下 off 会显式关闭 thinking；low/medium 会按 DeepSeek 兼容规则映射为 high，xhigh/max 映射为 max
# REASONING_EFFORT=off
# 可选：Agent 处理标题生成、路由判断等简单任务时使用的低成本模型，默认继承 MODEL_PROVIDER / MODEL_NAME
# LOW_COST_MODEL_PROVIDER=deepseek
# LOW_COST_MODEL_NAME=deepseek-v4-flash
# 可选：某些服务商需要显式配置；DeepSeek 默认使用 https://api.deepseek.com 拉取 /models
# API_BASE=
# 可选：阶段 2 的 web_fetch 默认关闭
# ENABLE_WEB_FETCH=true
# 可选：默认使用 LiteLLM 包内置模型价格表，避免本地启动时联网拉取 GitHub cost map 产生噪音 warning
# LITELLM_LOCAL_MODEL_COST_MAP=True
